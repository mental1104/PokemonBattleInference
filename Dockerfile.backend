FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/submodules/common/export/python:/app/submodules/common/python:/app

WORKDIR /app

COPY requirements.txt requirements-legacy-runtime.txt /tmp/
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-legacy-runtime.txt \
    && apt-get purge -y --auto-remove gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements.txt /tmp/requirements-legacy-runtime.txt

# Python仅作为保留的参考/兼容运行时；容器内保持相同真实布局和原导入名。
COPY legacy/pokeop /app/legacy/pokeop
RUN ln -s legacy/pokeop /app/pokeop
COPY scripts /app/scripts
COPY tool /app/tool
COPY models_pokeapi.py pytest.ini /app/
COPY submodules/common/python/mental1104 /app/submodules/common/python/mental1104
COPY submodules/pokeapi/data/v2/csv /app/submodules/pokeapi/data/v2/csv
