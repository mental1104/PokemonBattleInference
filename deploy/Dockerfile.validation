# 仅用于迁移验证的一次性工具环境；在线镜像不携带这些测试及 C++ 构建依赖。
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ make cmake libboost-dev libgtest-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /requirements.txt
# common 的顶层初始化依赖沿用当前 backend 镜像；HTTP 测试依赖统一从 requirements 安装。
RUN pip install --no-cache-dir -r /requirements.txt \
    genanki pypdf clickhouse-connect pymongo motor redis pycryptodome matplotlib \
    ruamel.yaml orjson ujson 'psycopg[binary]'
# 跨语言验证使用同一 C ABI；保留上面的 Python 层缓存。
RUN apt-get update \
    && apt-get install -y --no-install-recommends nlohmann-json3-dev golang-go \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
